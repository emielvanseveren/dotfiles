{
  "layer": "top",
  "margin": "5px 10px 0px 10px",
  "modules-left": ["sway/workspaces", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["network", "pulseaudio", "pulseaudio#microphone", "backlight", "power-profiles-daemon", "custom/mirror", "privacy", "cpu", "memory", "battery"],
  "height": "30px",

  "cpu": {
    "interval": 1,
    "format": "󰻠  {usage}%",
    "tooltip": false
  },

  "memory": {
    "interval": 1,
    "format": "󰍛  {used:0.1f}/{total:0.1f}GiB",
    "tooltip": false
  },

  "battery": {
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "󰚥  {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰁹"],
    "interval": 2,
    "states": {
      "warning": 30,
      "critical": 15
    }
  },

  "clock": {
    "interval": 1,
    "format": "{:%H:%M:%S}",
    "format-alt": "{:%A, %B %d | %H:%M:%S}"
  },

  "network": {
    "interface": "wl*",
    "format-wifi": "󰤨  {essid}",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰖁  muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip": false
  },

  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "󰍬  {volume}%",
    "format-source-muted": "󰍭  muted",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "tooltip": false
  },

  "backlight": {
    "format": "󰃟  {percent}%",
    "tooltip": false
  },

  "power-profiles-daemon": {
    "format": "{icon}  {profile}",
    "format-icons": {
      "performance": "󰓅",
      "balanced": "󰾅",
      "power-saver": "󰾆"
    },
    "tooltip": false
  },

  "custom/mirror": {
    "exec-if": "[ $(swaymsg -t get_outputs | jq length) -eq 2 ]",
    "exec": "pgrep -x wl-mirror >/dev/null && echo '󱒃  mirror' || echo '󰍺  extend'",
    "interval": "once",
    "signal": 8,
    "on-click": "~/.local/bin/mirror-toggle",
    "tooltip": false
  },

  "privacy": {
    "icon-size": 16
  }
}
