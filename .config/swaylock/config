# Hairline mono. STOCK swaylock 1.7.2 options only.
#
# swaylock stops reading this file at the first unknown option and silently
# ignores everything after it. Do NOT add swaylock-effects options here:
# clock, effect-blur, grace, grace-no-mouse, grace-no-touch, fade-in,
# datestr, indicator. Verify any edit with:
#   swaylock -d -C ~/.config/swaylock/config   (look for "unrecognized")
#
# Values are literal. Never quote them: font="X" keeps the quotes.
#
# Two knobs to taste:
#   indicator-radius  size of the circle
#   ring-color        how loud it is against the black

daemonize
ignore-empty-password
show-failed-attempts
indicator-caps-lock
indicator-idle-visible

color=000000
font=0xProto Nerd Font
font-size=14

indicator-radius=55
indicator-thickness=2

# idle and typing
inside-color=00000000
ring-color=6e6e6e
line-color=00000000
separator-color=00000000
text-color=8a8a8a
key-hl-color=c8c8c8
bs-hl-color=4a4a4a

# verifying
inside-ver-color=00000000
ring-ver-color=c8c8c8
line-ver-color=00000000
text-ver-color=c8c8c8

# wrong
inside-wrong-color=00000000
ring-wrong-color=c25a5a
line-wrong-color=00000000
text-wrong-color=c25a5a

# cleared
inside-clear-color=00000000
ring-clear-color=c8c8c8
line-clear-color=00000000
text-clear-color=c8c8c8

# caps lock
inside-caps-lock-color=00000000
ring-caps-lock-color=c09a4a
line-caps-lock-color=00000000
text-caps-lock-color=c09a4a
caps-lock-key-hl-color=c8c8c8
caps-lock-bs-hl-color=4a4a4a
