[init]
  defaultBranch = main

[branch]
  sort = -committerdate

[tag]
  sort = version:refname

[user]
  name = Emiel Van Severen
  useConfigOnly = true

[core]
  pager = delta # binary is delta but package is git-delta
  editor = nvim

[interactive]
  diffFilter = delta --color-only

[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true

[delta]
  navigate = true # use n and N to move between diff sections
  dark = true
  line-numbers = true
  true-color = always

[alias]
  c = commit -s # use git c to sign off commits

[credential]
  helper = cache

[column]
  ui = auto

[push]
  default = upstream
  autoSetupRemote = true
  followTags = true

[fetch]
  prune = true
  pruneTags = true
  all = true

[help]
  autocorrect = prompt

[rerere]
  enabled = true
  autoupdate = true

[pull]
  rebase = true

[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true
  instructionFormat = %s [%an]

[log]
  excludeDecoration = refs/prefetch/

[include]
  path = ~/.gitconfig-personal

[includeIf "gitdir:~/code/work/"] 
  path = ~/.gitconfig-work

[includeIf "gitdir:~/code/personal/"] 
  path = ~/.gitconfig-personal

[merge]
  conflictstyle = zdiff3
  tool = nvimdiff4
  prompt = false

[mergetool "nvimdiff4"]
  cmd = nvim -d $LOCAL $BASE $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'

[gpg]
  format = ssh
  program = /usr/bin/gpg

[color]
	ui = auto
[url "git@github.com:"]
	insteadOf = https://github.com/
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[maintenance]
	repo = /home/emiel/code/work/locos
